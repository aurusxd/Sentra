# FastAPI settings for landing-page lead notifications.
TELEGRAM_LEAD_BOT_TOKEN=replace_with_bot_token
TELEGRAM_LEAD_CHAT_ID=replace_with_numeric_chat_id
JWT_KEY=replace_with_at_least_32_random_characters
# JWT_SECURITY_KEY is accepted as a backwards-compatible alternative to JWT_KEY.
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key
REGISTRATION_ADMIN_EMAIL=owner@example.com
# One-time values used only by `python -m backend.scripts.create_admin`.
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters
COOKIE_SECURE=true
LOG_DIAGNOSE=false

POSTGRES_USER=sentra
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=sentra
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Server-side destination for the Next.js same-origin backend proxy.
BACKEND_INTERNAL_URL=https://api.sentra.fun
